# Copy values into ROOT/.local/backend.env using the Python runner, not shell source.
# The actual file must have permissions 0600 and is ignored by Git.
SPRING_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3306/robotai_ken?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia%2FHo_Chi_Minh&useSSL=false&allowPublicKeyRetrieval=true&rewriteBatchedStatements=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=REPLACE_LOCALLY
SPRING_DATA_REDIS_HOST=127.0.0.1
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_DATABASE=15
SPRING_PROFILES_ACTIVE=dev
XIAOZHI_DATA_DIR=REPLACE_WITH_ABSOLUTE_SHARED_RUNTIME_PATH
XIAOZHI_DEVICE_AUTH_SECRET=REPLACE_WITH_RANDOM_SECRET
JWT_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARS
ROBOTAI_MYSQL_CONTAINER=dev-mysql
ROBOTAI_REDIS_CONTAINER=dev-redis
# Redis currently accepts unauthenticated connections: omit password entirely.
# SPRING_DATA_REDIS_PASSWORD=SET_ONLY_IF_REDIS_REQUIRES_AUTH

# Optional resident Vietnamese STT worker (services/phowhisper/local.py).
XIAOZHI_STT_DEFAULT_PROVIDER=phowhisper
XIAOZHI_STT_PHOWHISPER_API_URL=http://127.0.0.1:8788/inference
